        <field-sort-custom-order field='F1' />
        <field-sort-custom-order field='acousticness' />
        <field-sort-custom-order field='danceability' />
        <field-sort-custom-order field='duration_ms' />
        <field-sort-custom-order field='energy' />
        <field-sort-custom-order field='instrumentalness' />
        <field-sort-custom-order field='key' />
        <field-sort-custom-order field='liveness' />
        <field-sort-custom-order field='loudness' />
